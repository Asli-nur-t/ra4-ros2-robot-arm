<?xml version="1.0"?>
<!--
  aslikol: 4 serbestlik dereceli (4-DoF) eklemli robot kol
  Geometrik sinif: R ⊢ R ∥ R ∥ R
    joint1: taban donusu (z ekseni)       } eksenler 90° kesisir  -> ⊢
    joint2: omuz (y ekseni)               }
    joint3: dirsek (y ekseni)             } eksenler paralel      -> ∥
    joint4: bilek (y ekseni)              }

  Tum olculer config/geometry.yaml dosyasindan okunur.
  Argumanlar:
    sim:=true|false          Gazebo eklentileri, sensorler ve ros2_control blogunu ekler
    controllers_file:=<yol>  gz_ros2_control icin kontrolcu YAML dosyasi (sim:=true iken)
-->
<robot name="aslikol" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="controllers_file" default=""/>

  <!-- ===================== Parametreler ===================== -->
  <xacro:property name="g" value="${xacro.load_yaml('$(find aslikol_description)/config/geometry.yaml')}"/>

  <xacro:property name="base_r" value="${g['base']['radius']}"/>
  <xacro:property name="h0"     value="${g['base']['height']}"/>
  <xacro:property name="base_m" value="${g['base']['mass']}"/>

  <xacro:property name="tur_r" value="${g['turret']['radius']}"/>
  <xacro:property name="h1"    value="${g['turret']['height']}"/>
  <xacro:property name="tur_m" value="${g['turret']['mass']}"/>

  <xacro:property name="l2" value="${g['upper_arm']['length']}"/>
  <xacro:property name="w2" value="${g['upper_arm']['width']}"/>
  <xacro:property name="m2" value="${g['upper_arm']['mass']}"/>

  <xacro:property name="l3" value="${g['forearm']['length']}"/>
  <xacro:property name="w3" value="${g['forearm']['width']}"/>
  <xacro:property name="m3" value="${g['forearm']['mass']}"/>

  <xacro:property name="l4" value="${g['wrist']['length']}"/>
  <xacro:property name="w4" value="${g['wrist']['width']}"/>
  <xacro:property name="m4" value="${g['wrist']['mass']}"/>

  <!-- ===================== Malzemeler (RViz + Gazebo) ===================== -->
  <material name="base_dark"><color rgba="0.18 0.20 0.23 1.0"/></material>
  <material name="turret_orange"><color rgba="0.93 0.45 0.13 1.0"/></material>
  <material name="arm_teal"><color rgba="0.10 0.55 0.60 1.0"/></material>
  <material name="arm_light"><color rgba="0.85 0.87 0.88 1.0"/></material>
  <material name="joint_gray"><color rgba="0.35 0.36 0.38 1.0"/></material>
  <material name="tool_red"><color rgba="0.85 0.12 0.15 1.0"/></material>
  <material name="camera_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ===================== Atalet makrolari ===================== -->
  <!-- Ekseni z olan dolu silindir; kutle merkezi z=cz -->
  <xacro:macro name="cylinder_inertial" params="m r h cz">
    <inertial>
      <origin xyz="0 0 ${cz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r + h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r + h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- Boyutlari (x, y, z) olan dolu kutu; kutle merkezi z=cz -->
  <xacro:macro name="box_inertial" params="m x y z cz">
    <inertial>
      <origin xyz="0 0 ${cz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y + z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x + z*z)/12}" iyz="0"
               izz="${m*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Cok kucuk kutleli yardimci link (tool0, camera_link) -->
  <xacro:macro name="tiny_inertial">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== Kol segmenti makrosu ===================== -->
  <!-- Link frame'i eklem noktasindadir; govde +z yonunde 'length' kadar uzanir.
       Eklem mafsali y ekseni boyunca yatan bir silindirle gosterilir. -->
  <xacro:macro name="arm_segment" params="name length width mass material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><box size="${width} ${width} ${length}"/></geometry>
        <material name="${material}"/>
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${width*0.75}" length="${width*1.5}"/></geometry>
        <material name="joint_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><box size="${width} ${width} ${length}"/></geometry>
      </collision>
      <xacro:box_inertial m="${mass}" x="${width}" y="${width}" z="${length}" cz="${length/2}"/>
    </link>
  </xacro:macro>

  <!-- ===================== Doner eklem makrosu ===================== -->
  <!-- Eklem frame'i parent frame'e gore (0, 0, z) kadar otelenir, eksen 'axis' etrafinda doner.
       Limitler geometry.yaml -> joints.<name> altindan okunur. -->
  <xacro:macro name="revolute_joint" params="name parent child z axis">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="0 0 ${z}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${g['joints'][name]['lower']}" upper="${g['joints'][name]['upper']}"
             effort="${g['joints'][name]['effort']}" velocity="${g['joints'][name]['velocity']}"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ===================== Linkler ve eklemler ===================== -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Frame 0: taban -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${h0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_r}" length="${h0}"/></geometry>
      <material name="base_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${h0/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_r}" length="${h0}"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="${base_m}" r="${base_r}" h="${h0}" cz="${h0/2}"/>
  </link>

  <!-- Frame 1: donen govde (turret) -->
  <xacro:revolute_joint name="joint1" parent="base_link" child="turret_link" z="${h0}" axis="0 0 1"/>

  <link name="turret_link">
    <visual>
      <origin xyz="0 0 ${h1/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${tur_r}" length="${h1}"/></geometry>
      <material name="turret_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${h1/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${tur_r}" length="${h1}"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="${tur_m}" r="${tur_r}" h="${h1}" cz="${h1/2}"/>
  </link>

  <!-- Frame 2: ust kol -->
  <xacro:revolute_joint name="joint2" parent="turret_link" child="upper_arm_link" z="${h1}" axis="0 1 0"/>
  <xacro:arm_segment name="upper_arm_link" length="${l2}" width="${w2}" mass="${m2}" material="arm_teal"/>

  <!-- Frame 3: on kol -->
  <xacro:revolute_joint name="joint3" parent="upper_arm_link" child="forearm_link" z="${l2}" axis="0 1 0"/>
  <xacro:arm_segment name="forearm_link" length="${l3}" width="${w3}" mass="${m3}" material="arm_light"/>

  <!-- Frame 4: bilek -->
  <xacro:revolute_joint name="joint4" parent="forearm_link" child="wrist_link" z="${l3}" axis="0 1 0"/>
  <xacro:arm_segment name="wrist_link" length="${l4}" width="${w4}" mass="${m4}" material="turret_orange"/>

  <!-- Frame 5: uc efektor (tool0) - bilek ucuna sabit -->
  <joint name="tool_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${l4}" rpy="0 0 0"/>
  </joint>

  <link name="tool0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="tool_red"/>
    </visual>
    <xacro:tiny_inertial/>
  </link>

  <!-- Kamera govdesi: bilegin yaninda, uc efektor yonune (+z) bakar.
       camera_link frame'inin +x ekseni gorus yonudur (ROS kamera govdesi gelenegi). -->
  <xacro:property name="cam_x" value="${w4/2 + 0.012}"/>
  <xacro:property name="cam_z" value="${l4*0.55}"/>

  <joint name="camera_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 ${-pi/2} 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.04 0.025"/></geometry>
      <material name="camera_black"/>
    </visual>
    <xacro:tiny_inertial/>
  </link>

  <!-- ===================== Simulasyon (sim:=true) ===================== -->
  <xacro:macro name="r2c_joint" params="name">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${g['joints'][name]['lower']}</param>
        <param name="max">${g['joints'][name]['upper']}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:if value="$(arg sim)">

    <ros2_control name="AslikolGazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:r2c_joint name="joint1"/>
      <xacro:r2c_joint name="joint2"/>
      <xacro:r2c_joint name="joint3"/>
      <xacro:r2c_joint name="joint4"/>
    </ros2_control>

    <gazebo>
      <!-- ros2_control: eklemleri ROS 2 kontrolculerine baglar -->
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>

      <!-- Fizik motorundaki gercek link pozlarini yayinlar (model frame'ine gore).
           Hata analizinde uc efektorun "olculen" konumu buradan gelir. -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>50</update_frequency>
      </plugin>
    </gazebo>

    <!-- tool0 sabit eklemle bagli oldugu icin URDF->SDF donusumunde bilege gomulurdu;
         ayri bir link olarak kalmasi icin sabit eklemi koru. -->
    <gazebo reference="tool_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- Sensorler bilek linkine baglidir -->
    <gazebo reference="wrist_link">
      <sensor name="wrist_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>aslikol/imu</topic>
        <frame_id>wrist_link</frame_id>
      </sensor>

      <!-- Dusuk cozunurluk (320x240, 10 Hz): sanal makinede goruntu islemcide
           (yazilimsal render) cizildigi icin simulasyon hizini korumak amaciyla secildi. -->
      <sensor name="wrist_camera" type="camera">
        <pose>${cam_x} 0 ${cam_z} 0 ${-pi/2} 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>aslikol/camera/image</topic>
        <frame_id>camera_link</frame_id>
        <camera>
          <camera_info_topic>aslikol/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:if>

</robot>
